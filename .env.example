# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: set to your server's ID for instant slash-command sync during
# development. Leave blank to sync globally (takes up to an hour to propagate).
GUILD_ID=

# Channel where pending card submissions get posted for mod approval
REVIEW_CHANNEL_ID=

# Role ID allowed to approve/reject submissions
MOD_ROLE_ID=

# How many cards a /drop shows at once
DROP_SIZE=3

# Cooldown between a member's drops, in seconds
DROP_COOLDOWN_SECONDS=3600
